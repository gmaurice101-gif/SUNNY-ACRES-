rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isSignedIn() {
      return request.auth != null;
    }

    match /cows/{cowId} {
      allow read, write: if isSignedIn();
    }

    match /milk_production/{recordId} {
      allow read, write: if isSignedIn();
    }

    match /egg_collection/{recordId} {
      allow read, write: if isSignedIn();
    }

    match /milk_sales/{saleId} {
      allow read, write: if isSignedIn();
    }

    match /egg_sales/{saleId} {
      allow read, write: if isSignedIn();
    }

    match /farm_users/{recordId} {
      allow read, write: if isSignedIn();
    }

    match /expenses/{expenseId} {
      allow read, write: if isSignedIn();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
